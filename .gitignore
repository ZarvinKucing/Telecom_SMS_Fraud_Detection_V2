# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Data and exports: never commit operational or generated data
data/*
!data/.gitkeep
out/
export/
exports/
*.csv
*.xlsx
*.xls
*.twb
*.twbx
*.hyper
*.parquet
*.sqlite
*.db
*.sql
*.dump

# Images are not committed unless generated by this project into docs/images
*.png
*.jpg
*.jpeg
!docs/images/*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.bak
common/db/models.py.phase1-backup
