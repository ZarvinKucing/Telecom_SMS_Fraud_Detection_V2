# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key

# Data and exports: never commit operational or generated data
data/*
!data/.gitkeep
out/
export/
exports/
*.csv
*.xlsx
*.xls
*.twb
*.twbx
*.hyper
*.parquet
*.sqlite
*.db

# Images are not committed unless generated by this project into docs/images
*.png
*.jpg
*.jpeg
!docs/images/*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
