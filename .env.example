# Copy to .env and fill in. Never commit .env.
# No default credentials are shipped on purpose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=fraud_platform
POSTGRES_PORT=5432

# Example form: postgresql+psycopg://USER:PASSWORD@localhost:5432/fraud_platform
DATABASE_URL=

# IANA zone used to interpret timestamps that carry no offset
SOURCE_TIMEZONE=UTC
# Comma-separated network names to analyse; empty means all networks
NETWORK_SCOPE=
INPUT_DIR=./data/incoming
PROCESSED_DIR=./data/processed
OUTPUT_DIR=./out
LOG_LEVEL=INFO
