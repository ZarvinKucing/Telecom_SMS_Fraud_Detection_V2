# Copy to .env and fill in. Never commit .env.
# No default credentials are shipped on purpose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# DATABASE_URL must use the fraud_api runtime role, never the migration owner.
DATABASE_URL=

# IANA zone used to interpret timestamps that carry no offset
SOURCE_TIMEZONE=UTC
# Comma-separated network names to analyse; empty means all networks
NETWORK_SCOPE=
INPUT_DIR=./data/incoming
PROCESSED_DIR=./data/processed
OUTPUT_DIR=./out
LOG_LEVEL=INFO

# Schema publishing is off by default. For local docs, explicitly use development + true.
APP_ENV=production
OPENAPI_PUBLIC=false

# API token verification (Phase 2: configured RS256 public key; Phase 3 may use Keycloak JWKS)
JWT_ISSUER=
JWT_AUDIENCE=fraud-api
JWT_PUBLIC_KEY_PEM=
MAX_INGEST_BYTES=5000000
